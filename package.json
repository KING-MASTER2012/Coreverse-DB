{
  "name": "@coreverse/db-client",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the Coreverse DB API, generated from openapi/openapi.yaml.",
  "type": "module",
  "license": "GPL-3.0-only",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run generate && git diff --exit-code src/generated && pnpm run typecheck"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@redocly/cli": "^2.49.1",
    "orval": "^8.27.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.12.0"
}
