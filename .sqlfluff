[sqlfluff]
dialect = postgres
templater = raw
# Migrations use Supabase/pgTAP-flavored SQL (DO blocks, SECURITY DEFINER
# functions, pgTAP's plan()/finish() calls) that fluff's stricter layout
# rules tend to false-positive on; keep this to structural/safety rules
# rather than full reformatting until the ruleset has been tuned against
# the real migration files.
exclude_rules = LT01, LT02, LT05, LT12, CP01, CP02, RF05

[sqlfluff:indentation]
tab_space_size = 2

[sqlfluff:rules:references.keywords]
ignore_words = role,version,path,label,status,type,key,value
