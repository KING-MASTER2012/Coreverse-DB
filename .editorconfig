# ============================================================
# Coreverse DB - EditorConfig
# ============================================================

root = true


# ============================================================
# Global Defaults
# ============================================================

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true


# ============================================================
# Source Code
# ============================================================

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_style = space
indent_size = 2

[*.{sql,pgsql,plpgsql}]
indent_style = space
indent_size = 2

[*.{json,jsonc,yaml,yml,toml}]
indent_style = space
indent_size = 2


# ============================================================
# Documentation
# ============================================================

[*.{md,mdx}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false


# ============================================================
# Shell Scripts
# ============================================================

[*.sh]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4


# ============================================================
# Configuration / Project Files
# ============================================================

[Dockerfile]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab


# ============================================================
# Git Files
# ============================================================

[.gitignore]
indent_style = space
indent_size = 2

[.gitattributes]
indent_style = space
indent_size = 2
