tmp/
temp/
.cache/
.cache-loader/

*.tmp
*.temp
*.bak
*.pid
*.seed
*.orig


# ============================================================
# Deno
# ============================================================

# Deno cache is normally outside the repository.
# Keep this section for project-local caches if any tooling creates them.
.deno/


# ============================================================
# Node.js / JavaScript Tooling
# ============================================================

node_modules/

# Do NOT ignore lockfiles that belong to the project.
# deno.lock should be committed.
#
# If pnpm/npm/yarn is introduced later, its lockfile should
# normally be committed as well.


